# ============================================================
# Sistema de Gestão de Alunos - Personal Trainer
# Copie este arquivo para .env e preencha com seus valores
# ============================================================

# Anthropic Claude API
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Sheets
# O ID está na URL da planilha:
# https://docs.google.com/spreadsheets/d/{GOOGLE_SHEETS_ID}/edit
GOOGLE_SHEETS_ID=your-google-sheets-id-here

# Google Drive - Pasta do Vault Obsidian
# O ID está na URL da pasta no Drive:
# https://drive.google.com/drive/folders/{GOOGLE_DRIVE_VAULT_FOLDER_ID}
GOOGLE_DRIVE_VAULT_FOLDER_ID=your-drive-folder-id-here

# Caminho para o arquivo de credenciais OAuth2 do Google Cloud
# Faça o download em: Google Cloud Console > APIs & Services > Credentials
GOOGLE_CREDENTIALS_PATH=./credentials.json
